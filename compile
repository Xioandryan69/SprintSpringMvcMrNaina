Comment compiler le projet?
# ── Étape 1 : Trouver servlet-api.jar dans Tomcat ──────────────────────
# Il se trouve dans le dossier lib de Tomcat, par exemple :
# /opt/tomcat/lib/servlet-api.jar

# ── Étape 2 : Compiler FrontController.java ─────────────────────────────
cd spring0
mkdir -p out

javac -cp lib/servlet-api.jar -d out src/FrontController.java

# ── Étape 3 : Créer le jar ───────────────────────────────────────────────
jar cf spring0.jar -C out .

# ── Étape 4 : Copier dans app-test ──────────────────────────────────────
mkdir -p ../app-test/WEB-INF/lib
cp spring0.jar ../app-test/WEB-INF/lib/

# ── Étape 5 : Déployer dans Tomcat ───────────────────────────────────────
# Copier app-test dans le dossier webapps de Tomcat :
cp -r ../app-test /opt/tomcat/webapps/

# ── Étape 6 : Lancer Tomcat ──────────────────────────────────────────────
/opt/tomcat/bin/startup.sh

# ── Tester ───────────────────────────────────────────────────────────────
# Ouvrir dans le navigateur :
# http://localhost:8080/app-test/
# http://localhost:8080/app-test/nimporte/quoi
# → Les deux affichent la même page !